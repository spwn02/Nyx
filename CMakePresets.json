{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{CXX26_CMAKE_TOOLCHAIN_FILE}",
        "VCPKG_TARGET_TRIPLET": "x64-linux-cxx26"
      }
    },
    {
      "name": "debug",
      "displayName": "Nyx Debug",
      "description": "Unoptimized development build using the selected C++26 toolchain",
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NYX_BUILD_PROFILE": "Debug",
        "CMAKE_DISABLE_PRECOMPILE_HEADERS": "ON"
      }
    },
    {
      "name": "development",
      "displayName": "Nyx Development",
      "description": "Optimized development build using the selected C++26 toolchain",
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NYX_BUILD_PROFILE": "Development",
        "CMAKE_DISABLE_PRECOMPILE_HEADERS": "ON"
      }
    },
    {
      "name": "development-tests",
      "displayName": "Nyx Development Tests",
      "description": "Unified Nyx + Miracle + Switch integration build using the selected C++26 toolchain",
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NYX_BUILD_PROFILE": "DevelopmentTests",
        "CMAKE_DISABLE_PRECOMPILE_HEADERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Nyx Release",
      "description": "Optimized production build using the selected C++26 toolchain",
      "inherits": "vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NYX_BUILD_PROFILE": "Release",
        "CMAKE_DISABLE_PRECOMPILE_HEADERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "debug",
      "jobs": 4
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 4
    },
    {
      "name": "development",
      "configurePreset": "development",
      "jobs": 4
    },
    {
      "name": "development-tests",
      "configurePreset": "development-tests",
      "jobs": 4,
      "targets": [
        "NyxEngine",
        "unit_tests"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "development-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "development-tests",
      "configurePreset": "development-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
