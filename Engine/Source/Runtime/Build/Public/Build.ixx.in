export module Nyx.Build;

export namespace Nyx::build {

enum class Platform : unsigned char {
  Linux,
  Windows,
  MacOS,
  IOS,
  Android,
  FreeBSD,
  Unsupported,
};

enum class Profile : unsigned char {
  Debug,
  Development,
  DevelopmentTests,
  Release,
};

inline constexpr Platform platform = Platform::@NYX_BUILD_PLATFORM@;
inline constexpr Profile profile = Profile::@NYX_BUILD_PROFILE_NAME@;

inline constexpr bool development = @NYX_BUILD_DEVELOPMENT@;
inline constexpr bool optimized = @NYX_BUILD_OPTIMIZED@;
inline constexpr bool tests = @NYX_BUILD_TESTS@;
inline constexpr bool exceptions = @NYX_BUILD_EXCEPTIONS@;
inline constexpr bool assertions = @NYX_BUILD_ASSERTIONS@;
inline constexpr bool expensiveChecks = @NYX_BUILD_EXPENSIVE_CHECKS@;
inline constexpr bool gpuValidation = @NYX_BUILD_GPU_VALIDATION@;
inline constexpr bool profiling = @NYX_BUILD_PROFILING@;

inline constexpr int exitSuccess = 0;
inline constexpr int exitFailure = 1;

} // namespace Nyx::build
